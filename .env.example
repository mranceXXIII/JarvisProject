# JARVIS environment example.
# Copy to .env and fill in values if you prefer environment variables over
# the Windows Credential Manager for local development ONLY.
#
# IMPORTANT (JARVIS_Project_Context.md section 5.9):
#   Production secrets belong in the secure credential store, referenced from
#   config YAML by credential_ref. Never commit .env to source control.

# Optional override for the credential store service name
# JARVIS_KEYRING_SERVICE=JARVIS

# Optional: logging level (DEBUG, INFO, WARNING, ERROR)
# JARVIS_LOG_LEVEL=INFO
